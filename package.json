{
  "name": "pocket_kneeboard",
  "description": "A companion chrome extension for Pocket Pilots",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt build && bin/browser reload",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "preview": "node scripts/preview.mjs",
    "screenshots": "wxt build && node scripts/preview.mjs --docs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0"
  }
}
